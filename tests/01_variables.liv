// 1. Примітивні числові типи
i8  min_int8  : -128
u8  max_uint8 : 255

i16 port     : 8080
u16 counter  : 65535

i32 id       : -100000
u32 flags    : 4294967295
f32 pi_short : 3.14

i64 big_id   : -9223372036854775807
u64 timestamp: 18446744073709551615
f64 pi_exact : 3.141592653589793

// 2. Текстовий тип та контейнери
str greeting : "Hello, Limao World!"

set  unique_ids
uset unordered_tags

map  user_scores
umap session_tokens

// 3. Різні формати оголошення та ініціалізації змінних
// Просте оголошення (без значення)
i32 uninit_var

// Оголошення з базовою ініціалізацією
i32 age : 25

// Ініціалізація кортежем / кількома значеннями в дужках
f32 coords : (12.5, 43.1, 0.0)

// Модифікатор доступу / анотації (#)
#u32 system_token : 99999

// Масиви та списки за допомогою []
i32 numbers : [10, 20, 30, 40]

// Рядок зі спецсимволами та дужками
str path : "../config/settings.json"